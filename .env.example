# The Odds API key (free plan: 500 credits a month). https://the-odds-api.com
ODDS_API_KEY=
# football-data.org token for match results (free plan). https://www.football-data.org
FOOTBALL_DATA_TOKEN=
# Telegram bot token from @BotFather, and the owner's chat id. Bettors join with /start and the owner's Allow button.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# Claude reads bet slips and typed bets. Without it the worker runs the scanner only.
ANTHROPIC_API_KEY=
# Docker Compose only: password of the bundled Postgres (the worker's DATABASE_URL is set in docker-compose.yml).
POSTGRES_PASSWORD=
# Postgres connection string. Leave empty to use an embedded PGlite database in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=data/pglite
# Optional dead man's switch, e.g. a healthchecks.io ping URL.
HEALTHCHECK_PING_URL=
LOG_LEVEL=info
# Optional JSON file overriding settings (leagues, bookmakers, thresholds, stakes).
CONFIG_PATH=
